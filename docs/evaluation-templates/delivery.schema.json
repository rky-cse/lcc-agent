        "unedited_single_take": {
          "title": "Unedited Single Take",
          "type": "boolean"
        },
        "voice_audible": {
          "title": "Voice Audible",
          "type": "boolean"
        },
        "continuous_sweep": {
          "title": "Continuous Sweep",
