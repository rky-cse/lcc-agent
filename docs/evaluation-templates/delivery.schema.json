        "inventory_live": {
          "title": "Inventory Live",
          "type": "boolean"
        },
        "final_packet_visible": {
          "title": "Final Packet Visible",
          "type": "boolean"
        },
        "evidence": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "duration_s",
        "sweep_id",
        "packet_sha256",
        "reviewer",
        "unedited_single_take",
        "voice_audible",
        "continuous_sweep",
        "inventory_live",
        "final_packet_visible",
        "evidence"
