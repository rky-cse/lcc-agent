{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Demo": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Duration S"
        },
        "sweep_id": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Sweep Id",
          "type": "string"
        },
        "packet_sha256": {
          "title": "Packet Sha256",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
